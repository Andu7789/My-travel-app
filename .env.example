# Supabase Configuration
# Get these from your Supabase project dashboard (https://supabase.com)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cesium Ion Token (optional - for enhanced map data)
# Get from https://ion.cesium.com/
VITE_CESIUM_ION_TOKEN=your-cesium-token-here

# API Configuration
VITE_API_URL=http://localhost:5173
